{
  "name": "@nooticr/mcp",
  "mcpName": "com.nooticr/mcp",
  "version": "1.26.32",
  "description": "MCP server for nooticr - fetch, discover and understand TikTok/Instagram/YouTube/X/Reddit/LinkedIn/Weibo posts with AI (media metadata, niche discovery, brand monitoring, hook & viral analysis)",
  "homepage": "https://mcp.nooticr.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nooticr/nooticr-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Nooticr/nooticr-mcp/issues"
  },
  "author": "Nooticr <support@nooticr.com>",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "nooticr-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "conformance:mcpjam": "sh scripts/mcpjam-apps-conformance.sh",
    "build": "npm run build:ui && tsc",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "login": "node dist/index.js login",
    "test": "vitest run",
    "prepare": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test tests/e2e/agentic-visual.e2e.ts tests/e2e/agentic-visual-full-app.e2e.ts",
    "test:e2e-smoke": "bash scripts/run-mechanical-e2e-smoke.sh",
    "test:e2e-smoke:fixture": "NOOTICR_E2E_BACKEND=fixture bash scripts/run-mechanical-e2e-smoke.sh",
    "test:quests": "bash scripts/run-quests.sh",
    "contract:host": "sh scripts/host-contract.sh",
    "chain:map": "bash scripts/run-chain-map.sh",
    "verify": "npm run build && npx tsc --noEmit && (cd cloudflare && npx tsc --noEmit) && npx vitest run && npm run contract:host && npm run chain:map && npm run conformance:mcpjam && npx playwright test",
    "contract:manifest": "node scripts/contract-check.mjs --from=../nooticr-server/platform-capabilities.json",
    "test:mutation": "node scripts/mutation-guard.mjs",
    "test:invariants": "node scripts/invariant-guard.mjs",
    "verify:deep": "npm run verify && npm run test:mutation && npm run test:invariants",
    "check:submission": "node scripts/check-submission-schema.mjs"
  },
  "keywords": [
    "mcp",
    "nooticr",
    "video",
    "analysis",
    "tiktok",
    "instagram",
    "youtube"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "hono": "^4.13.5"
  }
}
