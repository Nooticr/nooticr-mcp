{
  "name": "@orchyn/mcp",
  "mcpName": "com.orchyn/mcp",
  "version": "1.26.17",
  "description": "MCP server for orchyn - fetch, discover and understand TikTok/Instagram/YouTube/X/Reddit/LinkedIn/Weibo posts with AI (media metadata, niche discovery, brand monitoring, hook & viral analysis)",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "orchyn-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "conformance:mcpjam": "sh scripts/mcpjam-apps-conformance.sh",
    "build": "npm run build:ui && tsc",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "login": "node dist/index.js login",
    "test": "vitest run",
    "prepare": "npm run build",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "mcp",
    "orchyn",
    "video",
    "analysis",
    "tiktok",
    "instagram",
    "youtube"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "hono": "^4.13.5"
  }
}
