{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nooticr-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Gradual deployments: `wrangler deploy` uploads a new *version* without
  // sending it traffic, so a bad build is caught before it reaches anyone.
  // Roll it out with:
  //
  //   npm run deploy:version                 # upload, 0% traffic
  //   npx wrangler versions deploy           # pick versions + split, e.g. 10/90
  //   npx wrangler deployments status        # watch, then go to 100%
  //   npx wrangler rollback                  # instant revert
  //
  // This does NOT stop a deploy from restarting Durable Objects — nothing
  // does. It limits how many sessions a given rollout disturbs at once, and
  // the disconnect itself is absorbed by SSE resumability (see eventStore.ts)
  // plus idempotent tool calls, so a client reconnects and resumes instead of
  // erroring or being charged twice.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Plain config only. Two values are secrets and are deliberately absent
  // here: NOOTICR_ACCESS_TOKEN, and OPENAI_APPS_VERIFICATION_TOKEN — the
  // ChatGPT Apps domain-verification challenge served at
  // /.well-known/openai-apps-challenge. Both are set with
  // `wrangler secret put <NAME>` and take effect on the next deploy; the
  // challenge route 404s until its one is set, so an unconfigured deploy
  // cannot look like it is claiming a domain it isn't.
  "vars": {
    "PUBLIC_URL": "https://mcp.nooticr.com",
    "NOOTICR_BASE_URL": "https://api.nooticr.com"
  },
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "ef3e8501df1641bd9a6d97bca0c40eed"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_ENDPOINT",
        "class_name": "McpEndpoint"
      }
    ]
  },
  "exports": {
    "McpEndpoint": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "routes": [
    {
      "pattern": "mcp.nooticr.com",
      "custom_domain": true
    }
  ]
}
